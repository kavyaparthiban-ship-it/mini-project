# Environment variables for CrowdSense

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/crowdsense?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Server
SERVER_PORT=8080

# CORS (local frontend)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Crowd thresholds
CROWD_THRESHOLD_MODERATE=40
CROWD_THRESHOLD_HIGH=65
CROWD_THRESHOLD_CRITICAL=85
CROWD_STALE_MINUTES=720

# Recommendation weights (sum to 1.0)
REC_WEIGHT_CROWD=0.40
REC_WEIGHT_WAIT=0.20
REC_WEIGHT_TRAVEL=0.20
REC_WEIGHT_WALK=0.20

# Travel estimates
WAITING_HEADWAY=12
TRAVEL_SPEED=20

# Rewards
REWARD_POINTS=5
REWARD_MIN_IMPROVEMENT=15
